#!/bin/bash

#SUFFIX=";E-031647-995-05;8;AIP Weiterentw. Portfolio;;;"
#SUFFIX=";H-451008-11-01;8;AI Workbench Betriebskosten;;;"
psp_dev=E-031683-995-01
psp_ops=H-451008-11-01

is_working_day() {
  local offset=$1
  day_of_week=$(date -v -${offset}d +%u)
  if [[ $day_of_week -lt 6 ]]
  then
    return 0
  else
    return 1
  fi
}

get_file_name() {
  local prefix=$(date +"M%m")
  local suffix=.csv

  for x in {a..z}
  do
    if [ ! -e ${prefix}${x}${suffix} ]
    then
       echo ${prefix}${x}${suffix} 
       return
    fi
  done
  echo ${prefix}$$${suffix}
}

if [ -z "$1" ]
then
  echo "Usage: $(basename $0) <number_of_days_to_go_back> [number_of_days_to_book]"
  exit 1
fi

case $(basename $0) in
    dev)
        echo "Booking dev"
        suffices=(";${psp_dev};8;;;;")
        ;;
    ops)
        echo "Booking ops"
        suffices=(";${psp_ops};8;;;;")
        ;;
    devops)
        echo "Booking devops"
        suffices=(";${psp_dev};4;;;;" ";${psp_ops};4;;;;")
        ;;
    *)
        echo "Please call this script with one of: dev, ops or devops"
        exit 1
        ;;
esac

cd ~/adv

n=$1
m=${2:-${n}}
n=$((n - 1))
m=$((m - 1))
file=$(get_file_name)

echo Writing output to ${file}

while [[ $m -ge 0 && $n -ge 0 ]]
do
  if is_working_day ${n}
  then
    for suffix in "${suffices[@]}"
    do
      echo $(date -v -${n}d +%d.%m.%Y)${suffix} | tee -a "${file}"
    done
    m=$((m - 1))
  fi
  n=$((n - 1))
done
